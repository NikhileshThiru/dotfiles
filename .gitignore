# macOS
.DS_Store

# Editor swap/backup files
*.swp
*.swo
*~
.netrwhist

# Neovim: plugins and caches live in ~/.local/share/nvim and ~/.cache/nvim,
# but ignore anything that ends up inside the config dir by accident.
# (nvim-pack-lock.json IS tracked: it pins plugin versions across machines.)
nvim/.config/nvim/pack/
nvim/.config/nvim/plugin/packer_compiled.lua
nvim/.config/nvim/lazy-lock.json
# Compiled spell files (the .add word lists are tracked)
*.spl

# tmux plugins, if TPM is ever added
tmux/.tmux/plugins/
tmux/.config/tmux/plugins/

# Secrets: never commit these
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
id_ed25519*

# Backups made by install.sh, Omarchy (omarchy refresh) and by hand
*.bak
*.bak.*

# btop: Omarchy's theme link points into $HOME; install.sh recreates it
btop/.config/btop/themes/current.theme

# Spicetify: things it or the Marketplace regenerates
spicetify/.config/spicetify/Backup/
spicetify/.config/spicetify/Extracted/
spicetify/.config/spicetify/CustomApps/marketplace-tmp/
spicetify/.config/spicetify/CustomApps/*.zip
