mouse-hide-while-typing = true
background = 161616
background-opacity = 1.0
unfocused-split-opacity = 1.0

# Per-OS settings live in macos.conf and linux.conf. install.sh only links the
# one for the current OS, and the leading ? keeps Ghostty quiet about the other.
config-file = ?macos.conf
config-file = ?linux.conf
